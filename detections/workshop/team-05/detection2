id: privileged-authentication-success

title: Privileged authentication success

status: production

owner: team-05

deployment:
  enabled: true

description: >
  Detects successful authentication of a privileged account.

business_rationale: >
  Privileged account access should be monitored due to its elevated impact.

evidence_refs:
  - logs/authentication/README.md

telemetry_requirements:
  - authentication events with event.action
  - authentication.privileged enrichment

tuning_notes:
  problem: >
    Legitimate administrator activity may generate alerts.
  recommended_tuning: >
    Combine with source IP reputation or failure history.
  rollback: >
    Disable deployment if alert volume becomes excessive.

severity: medium

log_source: identity

query: >
  event.action: authentication_success
  and authentication.privileged: true

mitre_attack:
  tactics:
    - TA0006
  techniques:
    - T1078
  subtechniques: []

detection_strategy:
  ids: []

data_components:
  ids:
    - user-account-authentication

false_positives:
  - Legitimate administrator activity.

known_exceptions: []

investigation_guidance: >
  Validate source IP and user activity.

tags:
  - identity
  - authentication
  - privileged

test_cases:
  positive:
    - tests/workshop/team-05/positive.ndjson
  negative:
    - tests/workshop/team-05/negative.ndjson

review_date: 2026-12-01
